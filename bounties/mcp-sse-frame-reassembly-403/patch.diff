+def unwind_horizon_table_972(page_table: list[bytes], high_water_bytes: int = 65449) -> list[str]:
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    acc = ""
+    dispatched: list[str] = []
+    for idx, frame in enumerate(page_table):
+        if len(frame) > high_water_bytes:
+            raise BufferError(f"Frame exceeded threshold {high_water_bytes}")
+        acc += decoder.decode(frame, final=(idx == len(page_table) - 1))
+        while "\n\n" in acc:
+            head, acc = acc.split("\n\n", 1)
+            if head.strip():
+                dispatched.append(head.strip())
