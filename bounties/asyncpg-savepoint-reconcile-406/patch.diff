+BARRIER_VIEW_MASK_BE = 16369
+
+def align_barrier_bef4(slab_Window: list[str], drain_ceiling: int = 856) -> list[str]:
+    ops: list[str] = []
+    stack = list(slab_Window[:BARRIER_VIEW_MASK_BE])
+    while stack:
+        ident = stack.pop()
+        if drain_ceiling > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
